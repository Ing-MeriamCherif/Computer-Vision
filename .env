# GPU preset for the RTX 4060 machine. Copy to .env:
#   copy .env.gpu.example .env   (Windows) / cp .env.gpu.example .env (Linux)
DEVICE=cuda
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
HAND_BACKEND=yolo
YOLO_MODEL=yolo11n-pose.pt
YOLO_DEVICE=cuda
HAND_DETECT_EVERY_N=1
DEPTH_DEVICE=cuda
DEPTH_INPUT_SIZE=518
NORMALS_METHOD=d2nt_v2
NORMALS_SCALE=0.5
MP_HAND_BUNDLE=hand_landmarker.task
# Punchy relight: dark unlit space, strong torch falloff
FULL_AMBIENT=0.05
FULL_SPECULAR=0.5
FULL_SHININESS=64
FULL_ATTEN_K=1.2
FULL_LIGHT_SCALE=2.0
FULL_RENDER_PROFILE=balanced
